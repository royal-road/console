@@ -0,0 +1,21 @@
+import { parseTimeWindow } from '@/features/metrics/utils/time-window';
+
+describe('parseTimeWindow', () => {
+  it('reads from and to as epoch milliseconds', () => {
+    const params = new URLSearchParams('query0=up&from=1795442400000&to=1795446000000');
+    expect(parseTimeWindow(params)).toEqual({ from: 1795442400000, to: 1795446000000 });
+  });
+
+  it.each([
+    ['no parameters', ''],
+    ['only from', 'from=1795442400000'],
+    ['only to', 'to=1795446000000'],
+    ['a non-integer value', 'from=1795442400000.5&to=1795446000000'],
+    ['a non-numeric value', 'from=now-1h&to=now'],
+    ['a zero from', 'from=0&to=1795446000000'],
+    ['an empty window', 'from=1795446000000&to=1795446000000'],
+    ['a reversed window', 'from=1795446000000&to=1795442400000'],
+  ])('ignores %s', (_name, search) => {
+    expect(parseTimeWindow(new URLSearchParams(search))).toBeUndefined();
+  });
+});
diff --git a/web/src/features/metrics/utils/time-window.ts b/web/src/features/metrics/utils/time-window.ts
new file mode 100644
index 0000000..77ba321
--- /dev/null
+++ b/web/src/features/metrics/utils/time-window.ts
@@ -0,0 +1,11 @@
+export type TimeWindow = { from: number; to: number };
+
+// Reads the `from` and `to` URL parameters (epoch milliseconds). Returns undefined unless both are
+// positive integers with `from` before `to`.
+export const parseTimeWindow = (params: URLSearchParams): TimeWindow | undefined => {
+  const from = Number(params.get('from'));
+  const to = Number(params.get('to'));
+  return Number.isInteger(from) && Number.isInteger(to) && from > 0 && from < to
+    ? { from, to }
+    : undefined;
+};
