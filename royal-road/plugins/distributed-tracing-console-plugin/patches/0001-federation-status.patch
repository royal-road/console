diff --git a/web/src/components/FederationStatusAlert.tsx b/web/src/components/FederationStatusAlert.tsx
new file mode 100644
index 0000000..3c216a7
--- /dev/null
+++ b/web/src/components/FederationStatusAlert.tsx
@@ -0,0 +1,48 @@
+import { Alert, List, ListItem } from '@patternfly/react-core';
+import { useTranslation } from 'react-i18next';
+import { FederationRequestKind, isPartial, useFederationStatus } from '../federation';
+
+/**
+ * Royal Road: warns when some trace stores behind the federator did not
+ * contribute to the results on screen (timeout, error, unsupported query).
+ */
+export function FederationStatusAlert({ kind }: { kind: FederationRequestKind }) {
+  const { t } = useTranslation('plugin__distributed-tracing-console-plugin');
+  const statuses = useFederationStatus(kind);
+  const missing = (statuses ?? []).filter(isPartial);
+  if (missing.length === 0) {
+    return null;
+  }
+  const answered = (statuses ?? []).filter((s) => s.status === 'ok').map((s) => s.store);
+  return (
+    <Alert
+      variant="warning"
+      isInline
+      ouiaId="FederationPartialAlert"
+      title={t('Results may be incomplete: some trace stores did not answer')}
+    >
+      <List>
+        {missing.map((s) => (
+          <ListItem key={s.store}>
+            <strong>{s.store}</strong>: {statusText(s.status, t)}
+            {s.message ? ` (${s.message})` : ''}
+          </ListItem>
+        ))}
+      </List>
+      {answered.length > 0 && (
+        <p>{t('Results shown come from: {{stores}}', { stores: answered.join(', ') })}</p>
+      )}
+    </Alert>
+  );
+}
+
+function statusText(status: string, t: (s: string) => string) {
+  switch (status) {
+    case 'timeout':
+      return t('timed out');
+    case 'unsupported':
+      return t('cannot run this query');
+    default:
+      return t('failed');
+  }
+}
