diff --git a/web/src/federation.ts b/web/src/federation.ts
new file mode 100644
index 0000000..c1e491a
--- /dev/null
+++ b/web/src/federation.ts
@@ -0,0 +1,74 @@
+import { useSyncExternalStore } from 'react';
+import { UserFriendlyError } from '@perses-dev/client';
+
+/**
+ * Royal Road: the trace federator answers every Tempo API call with an
+ * X-Federation-Status header, a JSON list of {store, status, message}. The
+ * Perses Tempo client drops response headers, so the plugin gives it this
+ * fetchJson, which records the header before decoding the body.
+ */
+export interface StoreStatus {
+  store: string;
+  status: 'ok' | 'skipped' | 'denied' | 'unsupported' | 'error' | 'timeout';
+  message?: string;
+}
+
+export type FederationRequestKind = 'search' | 'trace';
+
+const latest: Partial<Record<FederationRequestKind, StoreStatus[]>> = {};
+const listeners = new Set<() => void>();
+
+function kindOf(url: string): FederationRequestKind | undefined {
+  if (url.includes('/api/search?') || url.endsWith('/api/search')) return 'search';
+  if (url.includes('/api/v2/traces/')) return 'trace';
+  return undefined;
+}
+
+function record(url: string, header: string | null) {
+  const kind = kindOf(url);
+  if (!kind) return;
+  let statuses: StoreStatus[] = [];
+  try {
+    statuses = header ? (JSON.parse(header) as StoreStatus[]) : [];
+  } catch {
+    statuses = [];
+  }
+  latest[kind] = statuses;
+  listeners.forEach((l) => l());
+}
+
+/** Drop-in replacement for @perses-dev/client fetchJson. */
+export async function federationFetchJson<T>(
+  input: string | URL | Request,
+  init?: RequestInit,
+): Promise<T> {
+  const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
+  const response = await globalThis.fetch(input, init);
+  record(url, response.headers.get('X-Federation-Status'));
+  if (!response.ok) {
+    let message = `${response.status} ${response.statusText}`;
+    try {
+      const body = await response.clone().json();
+      message = body.error ?? body.message ?? message;
+    } catch {
+      const text = await response.text();
+      if (text) message = text;
+    }
+    throw new UserFriendlyError(message, response.status);
+  }
+  return (await response.json()) as T;
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+/** Store statuses of the latest search or trace request. */
+export function useFederationStatus(kind: FederationRequestKind): StoreStatus[] | undefined {
+  return useSyncExternalStore(subscribe, () => latest[kind]);
+}
+
+export function isPartial(s: StoreStatus) {
+  return s.status === 'error' || s.status === 'timeout' || s.status === 'unsupported';
+}
