# Upstream source the image is built from. The plugin has no release branch
# for console 5.0; main at this commit builds against dynamic-plugin-sdk 4.22,
# React 18 and PatternFly 6, which console 5.0 serves. Bump UPSTREAM_COMMIT,
# then check that patches/ still applies.
UPSTREAM_REPO=https://github.com/openshift/distributed-tracing-console-plugin.git
UPSTREAM_BRANCH=main
UPSTREAM_COMMIT=6110b4641bc7e1158fcf8cf308bc82a6d3484db2
